{
  "chunk_size": 100,
  "data_sources": {
    "postgres": {
      "datasets": [
        {
          "table": "customers",
          "primary_key": ["customer_id"],
          "columns": [
            "customer_id",
            "first_name",
            "last_name",
            "email",
            "phone",
            "city",
            "state",
            "country",
            "created_at",
            "updated_at"
          ]
        },
        {
          "table": "products",
          "primary_key": ["product_id"],
          "columns": [
            "product_id",
            "product_name",
            "category",
            "brand",
            "unit_price",
            "cost_price",
            "stock_quantity",
            "created_at",
            "updated_at"
          ]
        },
        {
          "table": "orders",
          "primary_key": ["order_id"],
          "columns": [
            "order_id",
            "customer_id",
            "order_status",
            "order_date",
            "currency",
            "subtotal",
            "shipping_fee",
            "discount_amount",
            "total_amount",
            "updated_at"
          ]
        },
        {
          "table": "order_items",
          "primary_key": ["order_item_id"],
          "columns": [
            "order_item_id",
            "order_id",
            "product_id",
            "quantity",
            "unit_price",
            "discount_amount",
            "line_total"
          ]
        },
        {
          "table": "payments",
          "primary_key": ["payment_id"],
          "columns": [
            "payment_id",
            "order_id",
            "payment_method",
            "payment_status",
            "amount",
            "transaction_reference",
            "paid_at",
            "updated_at"
          ]
        }
      ]
    }
  }
}